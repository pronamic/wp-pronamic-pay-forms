{
	"name": "pronamic/wp-pronamic-pay-forms",
	"description": "The Pronamic Pay forms module.",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"autoload": {
		"psr-4": {
			"Pronamic\\WordPress\\Pay\\Forms\\": "src/"
		}
	},
	"authors": [
		{
			"name": "Pronamic",
			"email": "info@pronamic.eu"
		}
	],
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"automattic/jetpack-autoloader": true
		},
		"platform": {
			"php": "8.3"
		},
		"wp-slug": "pronamic-pay-forms"
	},
	"require": {
		"php": "^8.3",
		"wp-pay/core": "^4.35",
		"automattic/jetpack-autoloader": "^5.0 || ^6.0"
	},
	"require-dev": {
		"pronamic/wp-coding-standards": "^2.5",
		"rector/rector": "^2.8",
		"roots/wordpress-no-content": "^6.9",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "*"
	},
	"scripts": {
		"build": [
			"rm -rf ./build/stage-1",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --delete --delete-excluded --verbose --exclude-from=.distignore ./build/stage-1/ ./build/pronamic-pay-forms/",
			"vendor/bin/wp i18n make-pot ./build/pronamic-pay-forms/ --slug=pronamic-pay-forms",
			"vendor/bin/wp i18n make-mo ./build/pronamic-pay-forms/languages/",
			"vendor/bin/wp dist-archive ./build/pronamic-pay-forms/ --plugin-dirname=pronamic-pay-forms --force"
		],
		"dist-archive": "wp dist-archive . --plugin-dirname=pronamic-pay-forms",
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/pronamic-pay-forms/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/pronamic-pay-forms.pot"
		],
		"phpcbf": "XDEBUG_MODE=off vendor/bin/phpcbf",
		"phpcs": "XDEBUG_MODE=off vendor/bin/phpcs -s -v"
	}
}
